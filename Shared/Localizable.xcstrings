    "Zili açık kategorilerde teslim günü sabah bildirim gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories with the bell on notify you on the morning of the due date."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zili açık kategorilerde teslim günü sabah bildirim gelir."
