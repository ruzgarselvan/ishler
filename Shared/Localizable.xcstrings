    },
    "Zili açık kategorilerde son %lld gün her akşam, teslim günü sabah bildirim gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories with the bell on notify you every evening for the last %lld days, and on the morning of the due date."
          }
        },
        "tr": {
